{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(make build)",
      "Bash(make bundle)",
      "Bash(make run)",
      "Bash(make stop)",
      "Bash(make dump)",
      "Bash(make glyph)",
      "Bash(make panel)",
      "Bash(make dr)",
      "Bash(make list)",
      "Bash(make clean)",
      "Bash(make login-status)",
      "Bash(swift --version)",
      "Bash(swiftc --version)",
      "Bash(sw_vers)",
      "Bash(vm_stat)",
      "Bash(sysctl -n hw.memsize)",
      "Bash(sysctl -n hw.pagesize)",
      "Bash(sysctl -n vm.loadavg)",
      "Bash(codesign -d *)",
      "Bash(security find-identity *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(gh repo view *)"
    ],
    "deny": [
      "Bash(security find-generic-password *)",
      "Bash(security find-internet-password *)",
      "Bash(security dump-keychain *)",
      "Read(**/.credentials.json)",
      "Read(**/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(make install *)",
      "Bash(make uninstall *)",
      "Bash(make login-on *)",
      "Bash(make login-off *)",
      "Bash(security add-trusted-cert *)",
      "Bash(security delete-keychain *)"
    ]
  }
}
