{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(make build *)",
      "Bash(make bundle *)",
      "Bash(make run *)",
      "Bash(make stop *)",
      "Bash(make install *)",
      "Bash(make dump *)",
      "Bash(make glyph *)",
      "Bash(make panel *)",
