      "Bash(swift package describe *)",
      "Bash(swift --version)",
      "Bash(swiftc --version)",
      "Bash(codesign -d *)",
      "Bash(codesign -dv *)",
      "Bash(codesign -dvvv *)",
      "Bash(security find-identity *)",
      "Bash(vm_stat *)",
